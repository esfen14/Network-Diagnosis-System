#!/usr/bin/env bash
# Pinpoint VM lab (faithful lane): a real installer-built appliance in VirtualBox
# plus the demo target servers. See docs/plans/VM_Lab_Plan.md.
#
# The snapshot holds Ubuntu + Nagios only, never the app, so it cannot go stale
# when the code changes. A fresh test installs the app on it with the installer's
# own deploy steps; a quick test syncs the working tree into the running VM.
#
#   scripts/vmlab status               VM state, snapshots, snapshot stamp vs installer
#   scripts/vmlab provision [--force]  one time, on a fresh Ubuntu VM: run installer steps 1 to 5,
#                                      power off, take the snapshot (default os-nagios-ready)
#   scripts/vmlab fresh [branch]       restore the snapshot, start, install the app from the pushed
#                                      branch (default: current branch), healthcheck
#   scripts/vmlab sync [--client]      copy the working tree into the running appliance, restart
#                                      Gunicorn (--client also builds and copies client/dist)
#   scripts/vmlab health               installer healthcheck on the running appliance
#   scripts/vmlab smoke                log in, add the lab network, run discovery, wait for hosts up
#   scripts/vmlab creds                print the installer's administrator credentials (lab only)
#   scripts/vmlab up | down | revert   start (headless), power off, restore the snapshot only
#   scripts/vmlab targets <cmd...>     pass through to demo/demo_lab.py (up, down, wall, break, ...)
#
# Settings live outside the repository, in ~/.config/pinpoint-vmlab/env
# (override with VMLAB_CONFIG). Copy lab/vmlab.env.example there and edit it.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
config="${VMLAB_CONFIG:-$HOME/.config/pinpoint-vmlab/env}"

# Defaults, then the user's file.
VMLAB_VM="pinpoint-demo"
VMLAB_SNAPSHOT="os-nagios-ready"
VMLAB_SSH_TARGET=""
VMLAB_SSH_KEY=""
VMLAB_ADMIN_EMAIL=""
VMLAB_ADMIN_PASSWORD=""
VMLAB_LAB_NETWORK="10.77.0.0/28"
VMLAB_INSTALLER_REPO="https://github.com/lorraine-pangilinan/PinPoint-Installer.git"
VMLAB_INSTALLER_DIR="$HOME/.cache/pinpoint-vmlab/PinPoint-Installer"
# shellcheck disable=SC1090
[ -f "$config" ] && . "$config"

app_dir=/opt/pinpoint/Network-Diagnosis-System
remote_setup=/tmp/vmlab-setup
# Installer steps that do not depend on Pinpoint's code (the snapshot layer).
base_modules="install-packages.sh install-nagios-core.sh install-nagios-plugins.sh configure-snmp.sh configure-nagios.sh"
# Steps that install and wire the app (run fresh on every test).
app_modules="deploy-pinpoint-web.sh configure-pinpoint-privileges.sh"

die() { echo "vmlab: $*" >&2; exit 1; }
need_config() {
  command -v VBoxManage >/dev/null || die "VBoxManage not found"
  [ -n "$VMLAB_SSH_TARGET" ] || die "set VMLAB_SSH_TARGET (user@host of the appliance) in $config (see lab/vmlab.env.example)"
}

ssh_opts=(-o StrictHostKeyChecking=accept-new -o ConnectTimeout=5 -o ServerAliveInterval=15 -o LogLevel=ERROR)
ssh_args() { [ -n "$VMLAB_SSH_KEY" ] && printf -- '-i\n%s\n' "$VMLAB_SSH_KEY"; printf '%s\n' "${ssh_opts[@]}"; }
vm_ssh() {
  local extra=(); mapfile -t extra < <(ssh_args)
  ssh "${extra[@]}" "$VMLAB_SSH_TARGET" "$@"
}
vm_host() { echo "${VMLAB_SSH_TARGET#*@}"; }

vm_state() { VBoxManage showvminfo "$VMLAB_VM" --machinereadable 2>/dev/null | sed -n 's/^VMState="\(.*\)"/\1/p'; }
snapshot_exists() { VBoxManage snapshot "$VMLAB_VM" list --machinereadable 2>/dev/null | grep -q "^SnapshotName.*=\"$VMLAB_SNAPSHOT\""; }

wait_state() { # wait_state <state> <seconds>
  local want="$1" limit="$2" i
  for i in $(seq 1 "$limit"); do [ "$(vm_state)" = "$want" ] && return 0; sleep 1; done
  return 1
}
power_off() {
  [ "$(vm_state)" = "poweroff" ] && return 0
  VBoxManage controlvm "$VMLAB_VM" acpipowerbutton 2>/dev/null || true
  wait_state poweroff 90 || { echo "graceful shutdown timed out; powering off"; VBoxManage controlvm "$VMLAB_VM" poweroff; wait_state poweroff 30; }
}
start_vm() {
  [ "$(vm_state)" = "running" ] || VBoxManage startvm "$VMLAB_VM" --type headless >/dev/null
  echo "waiting for SSH on $VMLAB_SSH_TARGET ..."
  local i
  for i in $(seq 1 120); do vm_ssh true 2>/dev/null && return 0; sleep 3; done
  die "the appliance did not answer on SSH within 6 minutes"
}

installer_checkout() { # fetch the installer repo; echo its short commit
  mkdir -p "$(dirname "$VMLAB_INSTALLER_DIR")"
  if [ -d "$VMLAB_INSTALLER_DIR/.git" ]; then
    git -C "$VMLAB_INSTALLER_DIR" fetch -q origin && git -C "$VMLAB_INSTALLER_DIR" reset -q --hard origin/HEAD
  else
    git clone -q "$VMLAB_INSTALLER_REPO" "$VMLAB_INSTALLER_DIR"
  fi
  git -C "$VMLAB_INSTALLER_DIR" rev-parse --short HEAD
}
base_hash() { # a hash of the installer files behind the snapshot layer
  ( cd "$VMLAB_INSTALLER_DIR/setup" && cat $base_modules | sha256sum | cut -c1-12 )
}
push_setup() { # copy the installer's setup/ directory into the VM
  vm_ssh "rm -rf $remote_setup && mkdir -p $remote_setup"
  tar -C "$VMLAB_INSTALLER_DIR" -cf - setup | vm_ssh "tar -C $remote_setup -xf -"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//' ;;

  status)
    command -v VBoxManage >/dev/null || die "VBoxManage not found"
    echo "VM:        $VMLAB_VM ($(vm_state || echo missing))"
    echo "Snapshots:"; VBoxManage snapshot "$VMLAB_VM" list 2>&1 | sed 's/^/  /' | head -12
    snapshot_exists && echo "Base snapshot '$VMLAB_SNAPSHOT': present" || echo "Base snapshot '$VMLAB_SNAPSHOT': MISSING (run: scripts/vmlab provision)"
    if [ -n "$VMLAB_SSH_TARGET" ] && [ "$(vm_state)" = "running" ] && vm_ssh true 2>/dev/null; then
      stamp="$(vm_ssh 'cat /etc/pinpoint-vmlab-stamp 2>/dev/null' || true)"
      echo "Snapshot stamp (from the running VM): ${stamp:-none}"
      latest="$(installer_checkout)"; echo "Installer HEAD: $latest   base-step hash now: $(base_hash)"
      case "$stamp" in *"base_hash=$(base_hash)"*) echo "Stamp matches the installer's base steps." ;; *) echo "WARNING: installer base steps changed since the snapshot (or no stamp). Consider: scripts/vmlab provision --force" ;; esac
    fi
    ;;

  provision)
    need_config; force=0; [ "${1:-}" = "--force" ] && force=1
    if snapshot_exists && [ "$force" = 0 ]; then die "snapshot '$VMLAB_SNAPSHOT' exists; use --force to replace it"; fi
    [ "$(vm_state)" = "running" ] || { echo "Start the fresh Ubuntu VM first (scripts/vmlab up) and make sure SSH works."; start_vm; }
    echo "Installer: $(installer_checkout)"
    push_setup
    for m in $base_modules; do
      echo "=== $m"
      vm_ssh "cd $remote_setup/setup && sudo bash ./$m" || die "$m failed; fix it, then run provision again (it re-runs the steps)"
    done
    vm_ssh "echo \"installer=$(git -C "$VMLAB_INSTALLER_DIR" rev-parse --short HEAD) base_hash=$(base_hash) date=$(date -u +%FT%TZ)\" | sudo tee /etc/pinpoint-vmlab-stamp >/dev/null"
    power_off
    if snapshot_exists; then VBoxManage snapshot "$VMLAB_VM" delete "$VMLAB_SNAPSHOT"; fi
    VBoxManage snapshot "$VMLAB_VM" take "$VMLAB_SNAPSHOT" --description "Ubuntu + Nagios, no Pinpoint (scripts/vmlab)"
    echo "Snapshot '$VMLAB_SNAPSHOT' taken."
    ;;

  up)     need_config; start_vm ;;
  down)   need_config; power_off ;;
  revert) need_config; power_off; snapshot_exists || die "no snapshot '$VMLAB_SNAPSHOT'"; VBoxManage snapshot "$VMLAB_VM" restore "$VMLAB_SNAPSHOT" ;;

  fresh)
    need_config
    branch="${1:-$(git -C "$root" rev-parse --abbrev-ref HEAD)}"
    git -C "$root" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1 \
      || die "branch '$branch' is not pushed to origin; the installer's deploy step fetches it from GitHub (push it, or use: scripts/vmlab sync)"
    repo_url="$(git -C "$root" remote get-url origin)"
    case "$repo_url" in git@github.com:*) repo_url="https://github.com/${repo_url#git@github.com:}" ;; esac
    installer_checkout >/dev/null
    snapshot_exists || die "no snapshot '$VMLAB_SNAPSHOT' (run: scripts/vmlab provision)"
    power_off; VBoxManage snapshot "$VMLAB_VM" restore "$VMLAB_SNAPSHOT"; start_vm
    push_setup
    echo "Installing Pinpoint from $repo_url branch $branch ..."
    # The deploy step has the repository and branch hardcoded; patch a copy in the VM only.
    vm_ssh "sed -i -e 's|^REPO_URL=.*|REPO_URL=\"$repo_url\"|' -e 's|^REPO_BRANCH=.*|REPO_BRANCH=\"$branch\"|' $remote_setup/setup/deploy-pinpoint-web.sh"
    for m in $app_modules; do
      echo "=== $m"
      vm_ssh "cd $remote_setup/setup && sudo bash ./$m" || die "$m failed (log: sudo tail /var/log/pinpoint-*.log on the appliance)"
    done
    "$0" health
    echo "Fresh install of '$branch' is up: http://$(vm_host)  (credentials: scripts/vmlab creds)"
    ;;

  sync)
    need_config; with_client=0; [ "${1:-}" = "--client" ] && with_client=1
    vm_ssh true || die "cannot reach $VMLAB_SSH_TARGET (scripts/vmlab up)"
    extra=(); mapfile -t extra < <(ssh_args)
    rsync -az --delete \
      --exclude='.venv' --exclude='venv' --exclude='__pycache__' --exclude='*.db' --exclude='*.db.*' --exclude='tests' \
      --exclude='host-config-files' --exclude='running-host-config-backup' --exclude='database-backups' --exclude='backups' --exclude='.env' \
      -e "ssh ${extra[*]}" --rsync-path="sudo rsync" "$root/server/" "$VMLAB_SSH_TARGET:$app_dir/server/"
    if [ "$with_client" = 1 ]; then
      ( cd "$root/client" && { [ -d node_modules ] || npm ci; } && npm run build )
      rsync -az --delete -e "ssh ${extra[*]}" --rsync-path="sudo rsync" "$root/client/dist/" "$VMLAB_SSH_TARGET:$app_dir/client/dist/"
    fi
    vm_ssh "sudo chown -R pinpoint:pinpoint $app_dir/server $app_dir/client/dist 2>/dev/null; sudo systemctl restart pinpoint-gunicorn && systemctl is-active pinpoint-gunicorn"
    echo "synced (migrations are NOT run by sync; use 'fresh' when models change)"
    ;;

  health)
    need_config
    vm_ssh "test -f $remote_setup/setup/pinpoint-healthcheck.sh" 2>/dev/null || { installer_checkout >/dev/null; push_setup; }
    vm_ssh "sudo bash $remote_setup/setup/pinpoint-healthcheck.sh"
    ;;

  creds)
    need_config
    vm_ssh "sudo cat /root/pinpoint-install-credentials.txt 2>/dev/null || echo 'No stored credentials (already confirmed and removed?). Set VMLAB_ADMIN_EMAIL/VMLAB_ADMIN_PASSWORD.'"
    ;;

  smoke)
    need_config
    [ -n "$VMLAB_ADMIN_EMAIL" ] && [ -n "$VMLAB_ADMIN_PASSWORD" ] || die "set VMLAB_ADMIN_EMAIL and VMLAB_ADMIN_PASSWORD in $config (read them with: scripts/vmlab creds)"
    exec python3 -I "$root/lab/smoke.py" --base-url "http://$(vm_host)" --email "$VMLAB_ADMIN_EMAIL" \
      --password "$VMLAB_ADMIN_PASSWORD" --set-network "$VMLAB_LAB_NETWORK" "$@"
    ;;

  targets) exec python3 "$root/demo/demo_lab.py" "$@" ;;

  *) die "unknown command '$cmd' (try: scripts/vmlab help)" ;;
esac
