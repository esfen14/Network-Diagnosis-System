# Copy to ~/.config/pinpoint-vmlab/env (outside the repository) and edit.
# Never commit real values.

# The VirtualBox appliance VM and its base snapshot (Ubuntu + Nagios, no Pinpoint).
VMLAB_VM="pinpoint-demo"
VMLAB_SNAPSHOT="os-nagios-ready"

# How to reach it. The user needs passwordless sudo (run `sudo visudo` once on the VM:
#   youruser ALL=(ALL) NOPASSWD:ALL) and your SSH key in ~/.ssh/authorized_keys.
VMLAB_SSH_TARGET="youruser@192.168.1.50"
#VMLAB_SSH_KEY="$HOME/.ssh/id_ed25519"

# Pinpoint administrator, from `scripts/vmlab creds` after a fresh install, once the
# password has been changed in the browser (the smoke test refuses a pending change).
VMLAB_ADMIN_EMAIL=""
VMLAB_ADMIN_PASSWORD=""

# The demo lab network; the smoke test adds it to Network Discovery if missing.
VMLAB_LAB_NETWORK="10.77.0.0/28"
