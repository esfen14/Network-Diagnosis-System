# Optional: copy to ~/.config/pinpoint-vmlab/env (outside the repository) and edit.
# Every setting has a default; scripts/vmlab create builds a VM that matches them.
# Never commit real values.

# Use your own clone of the installer repository instead of a cached copy. It is only
# read (never fetched, reset or modified), so uncommitted installer edits are tested.
VMLAB_INSTALLER_DIR="$HOME/Documents/Capstone-FIles/PinPoint-Installer"

# The appliance VM and its base snapshot (Ubuntu + Nagios, no Pinpoint).
#VMLAB_VM="pinpoint-appliance"
#VMLAB_SNAPSHOT="os-nagios-ready"
#VMLAB_SSH_TARGET="lab@127.0.0.1"   # NAT port forward set up by `create`
#VMLAB_SSH_PORT="2250"
#VMLAB_WEB_PORT="8080"              # http://127.0.0.1:8080 reaches the appliance's Nginx

# Pinpoint administrator, from `scripts/vmlab creds` after a fresh install, once the
# password has been changed in the browser (the smoke test refuses a pending change).
VMLAB_ADMIN_EMAIL=""
VMLAB_ADMIN_PASSWORD=""

# The demo lab network; the smoke test adds it to Network Discovery if missing.
#VMLAB_LAB_NETWORK="10.77.0.0/28"
