# Lab-only settings, same names as /etc/pinpoint/pinpoint.env on a real
# appliance (README "Production settings"). Never reuse these values elsewhere.
SECRET_KEY=lab-only-not-a-secret-0123456789abcdef0123456789abcdef
NAGIOS_HOST=127.0.0.1
NAGIOS_PORT=8081
NAGIOS_USERNAME=pinpoint-api
NAGIOS_PASSWORD=lab-api-pass
PINPOINT_NETWORKS=10.78.0.0/24
PINPOINT_SCHEDULER=1
FLASK_DEBUG=0
FLASK_APP=server.py
