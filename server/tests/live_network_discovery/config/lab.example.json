{
  "schema_version": 1,
  "lab_network": "192.168.130.0/28",
  "pinpoint": {
    "address": "192.168.130.1",
    "base_url": "http://127.0.0.1:5000",
    "email_env": "PINPOINT_TEST_EMAIL",
    "password_env": "PINPOINT_TEST_PASSWORD"
  },
  "targets": {
    "target01": {
      "address": "192.168.130.2",
      "hostname": "target01.test.local",
      "ssh_user": "pinpoint-test",
      "ssh_key_env": "PINPOINT_TEST_SSH_KEY",
      "expected_tcp_ports": [21, 22, 25, 80, 443, 3306, 5693, 9000],
      "expected_udp_ports": []
    },
    "target02": {
      "address": "192.168.130.3",
      "hostname": "target02.test.local",
      "ssh_user": "pinpoint-test",
      "ssh_key_env": "PINPOINT_TEST_SSH_KEY",
      "expected_tcp_ports": [22, 53],
      "expected_udp_ports": [53, 69, 123, 161],
      "expected_skipped_udp_ports": [69]
    }
  },
  "discovery": {
    "tcp_ports": [21, 22, 25, 53, 80, 443, 3306, 5693, 9000],
    "udp_ports": [53, 69, 123, 161],
    "tcp_service_overrides": {
      "21": "ftp",
      "22": "ssh",
      "25": "smtp",
      "53": "dns",
      "80": "http",
      "443": "https",
      "3306": "mysql",
      "5693": "ncpa",
      "9000": "testtcp"
    },
    "udp_service_overrides": {
      "53": "dns",
      "123": "ntp",
      "161": "snmp"
    },
    "timeout_seconds": 3600,
    "poll_seconds": 5
  },
  "nagios": {
    "binary": "/usr/local/nagios/bin/nagios",
    "main_config": "/usr/local/nagios/etc/nagios.cfg",
    "service_name": "nagios"
  },
  "databases": {
    "system": "../../../system.db"
  },
  "output_root": "/home/tester/pinpoint-test-results"
}
